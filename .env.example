# Copy to .env and set your values.
# .env is gitignored; do not commit secrets.

# Data root: folder where chat history, login DB, vector store, BareActs, and CaseLaws live.
# Set to a Google Drive folder path to store everything in Drive (use Google Drive for Desktop to mount it).
# Use forward slashes in .env to avoid escape issues.
# Examples:
#   Windows:  NYAYMALAW_DATA_ROOT=G:/My Drive/Nyaymalaw
#   macOS:    NYAYMALAW_DATA_ROOT=/Users/you/Google Drive/Nyaymalaw
# Leave unset to use project/data (default).
# NYAYMALAW_DATA_ROOT=G:/My Drive/Nyaymalaw

# ---------------------------------------------------------------------------
# Frontend (Vite) – used when building the React app (e.g. npm run build).
# Set this when your API is hosted at a different URL than the website.
# Example: API on subdomain
#   VITE_API_BASE=https://api.nyaymalaw.in
# If unset, the frontend uses the same origin (e.g. https://nyaymalaw.in) in production.
# VITE_API_BASE=

# ---------------------------------------------------------------------------
# Ollama / LLM (optional)
# Default model for short prompts; long-context model used when prompt > threshold.
# LONG_CONTEXT_THRESHOLD is in characters; 120000 ≈ 30K tokens.
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_MODEL_LONG_CONTEXT=llama3.1:8b
# LONG_CONTEXT_THRESHOLD=120000
