      "chunk_id": "SC_2021_THE_STATE_OF_RAJASTHAN_VS_SHIV_CHARAN_MEENA_P012_C01",
      "text": "Court by its judgment and order dated 16.11.2017.\nBeing aggrieved, the State Government has preferred the instant appeal.",
      "paragraph_type": "unknown",
      "sections_cited": [],
      "cited_cases": [],
      "chunk_number": 1
    },
