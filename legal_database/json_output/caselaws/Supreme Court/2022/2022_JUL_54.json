      "paragraph_type": "facts",
      "sections_cited": [],
      "cited_cases": [],
      "chunk_number": 1
    },
    {
      "paragraph_id": 14,
      "chunk_id": "SC_2022_HEMANT_KUMAR_VERMA_VS_EMPLOYEES_STATE_INSURANCE_CORPORATI_P014_C01",
      "text": "respondent-institution seeking to be considered in the ‘in-service’ quota for DNB",
