      "chunk_id": "SC_2022_HEMANT_KUMAR_VERMA_VS_EMPLOYEES_STATE_INSURANCE_CORPORATI_P043_C01",
      "text": "will be fixed by the competent authority. It mentions that “they will be required to perform",
      "paragraph_type": "unknown",
      "sections_cited": [],
      "cited_cases": [],
      "chunk_number": 1
    },
