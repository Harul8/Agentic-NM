{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "wsl.exe bash \"/mnt/c/Users/rahul/Agentic NM/crg_update.sh\"",
            "timeout": 20000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "wsl.exe bash \"/mnt/c/Users/rahul/Agentic NM/crg_status.sh\"",
            "timeout": 15000
          }
        ]
      }
    ],
    "PreCommit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "wsl.exe bash \"/mnt/c/Users/rahul/Agentic NM/crg_detect_changes.sh\"",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
